{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ApiDocument",
  "oneOf": [
    {
      "$ref": "#/definitions/SessionDocument"
    },
    {
      "$ref": "#/definitions/PreferencesDocument"
    },
    {
      "$ref": "#/definitions/AccountsDocument"
    },
    {
      "$ref": "#/definitions/MailboxesDocument"
    },
    {
      "$ref": "#/definitions/MessagesDocument"
    },
    {
      "$ref": "#/definitions/ErrorDocument"
    }
  ],
  "definitions": {
    "Handle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "Cursor": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "pattern": "^[a-f0-9]{32}$"
    },
    "SessionDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authenticated"],
      "properties": {
        "authenticated": {
          "type": "boolean",
          "enum": [true]
        }
      }
    },
    "PreferencesDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme"],
      "properties": {
        "theme": {
          "$ref": "#/definitions/Theme"
        }
      }
    },
    "Theme": {
      "type": "string",
      "enum": ["system", "light", "dark"]
    },
    "AccountsDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accounts"],
      "properties": {
        "accounts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Account"
          }
        }
      }
    },
    "Account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "identities"],
      "properties": {
        "id": {
          "$ref": "#/definitions/Handle"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "identities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Identity"
          }
        }
      }
    },
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "email"],
      "properties": {
        "id": {
          "$ref": "#/definitions/Handle"
        },
        "name": {
          "type": "string",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "minLength": 1,
          "maxLength": 254
        }
      }
    },
    "MailboxesDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mailboxes", "truncated"],
      "properties": {
        "mailboxes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Mailbox"
          }
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "Mailbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "$ref": "#/definitions/Handle"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "parent": {
          "$ref": "#/definitions/Handle"
        },
        "role": {
          "$ref": "#/definitions/MailboxRole"
        }
      }
    },
    "MailboxRole": {
      "type": "string",
      "enum": ["inbox", "drafts", "sent", "trash", "archive", "junk", "templates", "outbox"]
    },
    "MessagesDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messages"],
      "properties": {
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MessageSummary"
          }
        },
        "cursor": {
          "$ref": "#/definitions/Cursor"
        }
      }
    },
    "MessageSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject", "author", "recipients", "date", "read", "flagged"],
      "properties": {
        "id": {
          "$ref": "#/definitions/Handle"
        },
        "subject": {
          "type": "string",
          "maxLength": 300
        },
        "author": {
          "type": "string",
          "maxLength": 300
        },
        "recipients": {
          "type": "string",
          "maxLength": 300
        },
        "date": {
          "type": "string",
          "minLength": 20,
          "maxLength": 20,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "read": {
          "type": "boolean"
        },
        "flagged": {
          "type": "boolean"
        }
      }
    },
    "ErrorDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "$ref": "#/definitions/ApiError"
        }
      }
    },
    "ApiError": {
      "type": "string",
      "enum": [
        "unauthenticated",
        "forbidden_origin",
        "invalid_request",
        "rate_limited",
        "invalid_password",
        "login_unconfigured",
        "storage_unavailable",
        "backend_disconnected",
        "backend_busy",
        "backend_timeout",
        "stale_handle",
        "stale_cursor",
        "unsupported",
        "backend_failed"
      ]
    }
  }
}
