{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConnectorMessage",
  "oneOf": [
    { "$ref": "#/definitions/Authenticate" },
    { "$ref": "#/definitions/Welcome" },
    { "$ref": "#/definitions/Ping" },
    { "$ref": "#/definitions/Pong" },
    { "$ref": "#/definitions/ProtocolError" }
  ],
  "definitions": {
    "Generation": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "pattern": "^[a-f0-9]{32}$"
    },
    "Capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 0,
      "uniqueItems": true
    },
    "Authenticate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "token",
        "backend_kind",
        "backend_version",
        "connector_version",
        "capabilities"
      ],
      "properties": {
        "type": { "type": "string", "enum": ["authenticate"] },
        "protocol_version": { "type": "integer", "enum": [1] },
        "token": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "backend_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "backend_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[ -~]+$"
        },
        "connector_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[ -~]+$"
        },
        "capabilities": { "$ref": "#/definitions/Capabilities" }
      }
    },
    "Welcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "generation",
        "capabilities",
        "heartbeat_interval_ms",
        "heartbeat_timeout_ms"
      ],
      "properties": {
        "type": { "type": "string", "enum": ["welcome"] },
        "protocol_version": { "type": "integer", "enum": [1] },
        "generation": { "$ref": "#/definitions/Generation" },
        "capabilities": { "$ref": "#/definitions/Capabilities" },
        "heartbeat_interval_ms": { "type": "integer", "enum": [15000] },
        "heartbeat_timeout_ms": { "type": "integer", "enum": [45000] }
      }
    },
    "Ping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_version", "generation", "sequence"],
      "properties": {
        "type": { "type": "string", "enum": ["ping"] },
        "protocol_version": { "type": "integer", "enum": [1] },
        "generation": { "$ref": "#/definitions/Generation" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
      }
    },
    "Pong": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_version", "generation", "sequence"],
      "properties": {
        "type": { "type": "string", "enum": ["pong"] },
        "protocol_version": { "type": "integer", "enum": [1] },
        "generation": { "$ref": "#/definitions/Generation" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
      }
    },
    "ProtocolError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_version", "code"],
      "properties": {
        "type": { "type": "string", "enum": ["error"] },
        "protocol_version": { "type": "integer", "enum": [1] },
        "generation": { "$ref": "#/definitions/Generation" },
        "code": {
          "type": "string",
          "enum": [
            "authentication_failed",
            "incompatible_version",
            "invalid_message",
            "message_too_large",
            "unexpected_message",
            "stale_generation",
            "heartbeat_timeout",
            "session_replaced",
            "server_busy"
          ]
        }
      }
    }
  }
}
