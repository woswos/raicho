{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConnectorMessage",
  "oneOf": [
    {
      "$ref": "#/definitions/Challenge"
    },
    {
      "$ref": "#/definitions/Authenticate"
    },
    {
      "$ref": "#/definitions/Welcome"
    },
    {
      "$ref": "#/definitions/Ping"
    },
    {
      "$ref": "#/definitions/Pong"
    },
    {
      "$ref": "#/definitions/ProtocolError"
    }
  ],
  "definitions": {
    "Generation": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "pattern": "^[a-f0-9]{32}$"
    },
    "Nonce": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "Signature": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "Capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 0,
      "uniqueItems": true
    },
    "Challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_version", "server_nonce"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["challenge"]
        },
        "protocol_version": {
          "type": "integer",
          "enum": [1]
        },
        "server_nonce": {
          "$ref": "#/definitions/Nonce"
        }
      }
    },
    "Authenticate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "backend_kind",
        "backend_version",
        "connector_version",
        "capabilities",
        "client_nonce",
        "client_proof"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["authenticate"]
        },
        "protocol_version": {
          "type": "integer",
          "enum": [1]
        },
        "backend_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "backend_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[ -~]+$"
        },
        "connector_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[ -~]+$"
        },
        "capabilities": {
          "$ref": "#/definitions/Capabilities"
        },
        "client_nonce": {
          "$ref": "#/definitions/Nonce"
        },
        "client_proof": {
          "$ref": "#/definitions/Signature"
        }
      }
    },
    "Welcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_version", "generation", "capabilities", "server_signature"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["welcome"]
        },
        "protocol_version": {
          "type": "integer",
          "enum": [1]
        },
        "generation": {
          "$ref": "#/definitions/Generation"
        },
        "capabilities": {
          "$ref": "#/definitions/Capabilities"
        },
        "server_signature": {
          "$ref": "#/definitions/Signature"
        }
      }
    },
    "Ping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_version", "generation", "sequence", "mac"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ping"]
        },
        "protocol_version": {
          "type": "integer",
          "enum": [1]
        },
        "generation": {
          "$ref": "#/definitions/Generation"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "mac": {
          "$ref": "#/definitions/Signature"
        }
      }
    },
    "Pong": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_version", "generation", "sequence", "mac"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["pong"]
        },
        "protocol_version": {
          "type": "integer",
          "enum": [1]
        },
        "generation": {
          "$ref": "#/definitions/Generation"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "mac": {
          "$ref": "#/definitions/Signature"
        }
      }
    },
    "ProtocolError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_version", "code"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["error"]
        },
        "protocol_version": {
          "type": "integer",
          "enum": [1]
        },
        "generation": {
          "$ref": "#/definitions/Generation"
        },
        "code": {
          "type": "string",
          "enum": [
            "authentication_failed",
            "incompatible_version",
            "invalid_message",
            "message_too_large",
            "unexpected_message",
            "stale_generation",
            "heartbeat_timeout",
            "session_replaced",
            "server_busy"
          ]
        },
        "mac": {
          "$ref": "#/definitions/Signature"
        }
      }
    }
  }
}
